# ============================================================
# ExecCal 環境變數範本
# 複製本檔為 .env.local 後填入你的 Supabase 專案金鑰
# （.env.local 已被 .gitignore 忽略，不會進版控）
# ============================================================

# Supabase 專案 URL，例如 https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon（public）金鑰
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role 金鑰（僅供 seed 腳本在本機使用，切勿外流／勿加 NEXT_PUBLIC_ 前綴）
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API 金鑰（語音新增行程用，把口語解析成結構化行程；切勿加 NEXT_PUBLIC_ 前綴）
ANTHROPIC_API_KEY=
